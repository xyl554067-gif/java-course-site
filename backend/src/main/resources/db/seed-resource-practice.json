    "exercise": {
      "title": "遍历 JDBC 结果集读取课时标题",
      "description": "第一行是查询结果的行数 n，后面 n 行各为一个非空课时标题，可以包含空格。主程序用这些输入构造内存中的 JDBC 结果集。实现 readTitles，从光标位于首行之前的 ResultSet 中按顺序读取 title 列。主程序每行输出一个标题，结果为空时输出 EMPTY。\n\n示例输入\n2\nJava Basics\nWorking with JDBC\n\n示例输出\nJava Basics\nWorking with JDBC",
      "difficulty": "INTERMEDIATE",
      "hint": "在 while 循环内用 next() 移动光标，并通过列名 title 读取数据。",
      "sortOrder": 108,
      "starterCode": [
        "import java.io.BufferedReader;",
        "import java.io.InputStreamReader;",
        "import java.sql.ResultSet;",
        "import java.sql.SQLException;",
        "import java.sql.Types;",
        "import java.util.ArrayList;",
        "import java.util.List;",
        "import javax.sql.rowset.RowSetMetaDataImpl;",
        "import javax.sql.rowset.RowSetProvider;",
        "",
        "public class Main {",
        "    static List<String> readTitles(ResultSet rows) throws SQLException {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) throws Exception {",
        "        try (var input = new BufferedReader(new InputStreamReader(System.in));",
        "             var rows = RowSetProvider.newFactory().createCachedRowSet()) {",
        "            var metadata = new RowSetMetaDataImpl();",
        "            metadata.setColumnCount(1);",
        "            metadata.setColumnName(1, \"title\");",
        "            metadata.setColumnType(1, Types.VARCHAR);",
        "            rows.setMetaData(metadata);",
        "            int count = Integer.parseInt(input.readLine());",
        "            for (int i = 0; i < count; i++) {",
        "                rows.last();",
        "                rows.moveToInsertRow();",
        "                rows.updateString(1, input.readLine());",
        "                rows.insertRow();",
        "                rows.moveToCurrentRow();",
        "            }",
        "            rows.beforeFirst();",
        "            List<String> titles = readTitles(rows);",
        "            if (titles.isEmpty()) {",
        "                System.out.println(\"EMPTY\");",
        "            } else {",
        "                titles.forEach(System.out::println);",
        "            }",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        var titles = new ArrayList<String>();",
        "        while (rows.next()) {",
        "            titles.add(rows.getString(\"title\"));",
        "        }",
        "        return titles;"
      ],
      "cases": [
        {
          "name": "多行及空格",
          "stdin": "2\nJava Basics\nWorking with JDBC\n",
          "expected": "Java Basics\nWorking with JDBC"
        },
        {
          "name": "空结果",
          "stdin": "0\n",
          "expected": "EMPTY"
        },
        {
          "name": "单行",
          "stdin": "1\nInterfaces\n",
          "expected": "Interfaces"
        },
        {
          "name": "保留顺序和重复行",
          "stdin": "4\nThreads\nArrays\nThreads\nStreams\n",
          "expected": "Threads\nArrays\nThreads\nStreams"
        }
      ]
    }
  }
