    "exercise": {
      "title": "按动态分数线计算平均分",
      "description": "第一行给出成绩数 n 和分数线 t，接下来是 n 个 0 到 100 的整数成绩。用 Stream 计算大于等于 t 的成绩的平均分。没有符合条件的成绩时输出 NONE，其余情况输出保留两位小数的平均值。\n\n示例输入\n4 70\n100 65 70 85\n\n示例输出\n85.00",
      "difficulty": "INTERMEDIATE",
      "hint": "filter 负责筛选，然后转换为整数流并调用 average()。",
      "sortOrder": 104,
      "starterCode": [
        "import java.util.ArrayList;",
        "import java.util.List;",
        "import java.util.Locale;",
        "import java.util.OptionalDouble;",
        "import java.util.Scanner;",
        "",
        "public class Main {",
        "    static OptionalDouble passingAverage(List<Integer> scores, int threshold) {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) {",
        "        try (Scanner input = new Scanner(System.in)) {",
        "            int size = input.nextInt();",
        "            int threshold = input.nextInt();",
        "            var scores = new ArrayList<Integer>();",
        "            for (int i = 0; i < size; i++) {",
        "                scores.add(input.nextInt());",
        "            }",
        "            OptionalDouble average = passingAverage(scores, threshold);",
        "            if (average.isPresent()) {",
        "                System.out.printf(Locale.ROOT, \"%.2f%n\", average.getAsDouble());",
        "            } else {",
        "                System.out.println(\"NONE\");",
        "            }",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        return scores.stream()",
        "                .filter(score -> score >= threshold)",
        "                .mapToInt(Integer::intValue)",
        "                .average();"
