      ],
      "answerKey": "TRUE"
    },
    "exercise": {
      "title": "实现带最低余额的积分账户",
      "description": "首行给出初始余额和最低保留余额，满足 0 ≤ 最低保留余额 ≤ 初始余额。第二行给出请求数 n，接下来是 n 个带符号的整数金额。提现必须为正，成功后余额须至少等于最低保留余额。\n\n每个请求输出一行 true 或 false，最后一行输出最终余额。金额与余额均在 int 范围内。\n\n示例输入\n100 20\n3\n30 60 50\n\n示例输出\ntrue\nfalse\ntrue\n20",
      "difficulty": "BEGINNER",
      "hint": "可提现金额是 balance - reserve。确认请求合法后再更新余额。",
      "sortOrder": 102,
      "starterCode": [
        "import java.util.Scanner;",
        "",
        "public class Main {",
        "    static final class Account {",
        "        private int balance;",
        "        private final int reserve;",
        "",
        "        Account(int balance, int reserve) {",
        "            this.balance = balance;",
        "            this.reserve = reserve;",
        "        }",
        "",
        "        boolean withdraw(int amount) {",
        "            throw new UnsupportedOperationException(\"请完成方法\");",
        "        }",
        "",
        "        int balance() {",
        "            return balance;",
        "        }",
        "    }",
        "",
        "    public static void main(String[] args) {",
        "        try (Scanner input = new Scanner(System.in)) {",
        "            Account account = new Account(input.nextInt(), input.nextInt());",
        "            int requests = input.nextInt();",
        "            for (int i = 0; i < requests; i++) {",
        "                System.out.println(account.withdraw(input.nextInt()));",
        "            }",
        "            System.out.println(account.balance());",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "            if (amount <= 0 || amount > balance - reserve) {",
        "                return false;",
        "            }",
        "            balance -= amount;",
        "            return true;"
      ],
