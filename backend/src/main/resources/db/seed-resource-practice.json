    "noteId": "jvm-heap-observation",
    "lessonSlug": "jvm-tuning-tools",
    "question": {
      "type": "SHORT_ANSWER",
      "difficulty": "MEDIUM",
      "prompt": "两次 jcmd GC.heap_info 采样发现已用堆增加。至少应补做哪些观察，才能判断是否值得继续排查内存泄漏？",
      "explanation": "在同一测试程序和相近负载下多次采样，对照垃圾回收后的用量是否持续增长。若增长持续，再检查相关对象是否仍被引用。"
    },
    "exercise": {
      "title": "比较两次堆用量采样",
      "description": "读入两次简化的堆用量记录，只包含非负整数和单位 K、M 或 G。将记录换算成字节，输出第二次用量减第一次用量。K、M、G 分别表示 1024、1024²、1024³ 字节。结果可能为负，输入及换算结果保证在 long 范围内。\n\n示例输入\n512K 2M\n\n示例输出\n1572864",
      "difficulty": "INTERMEDIATE",
      "hint": "通过末尾字符判断单位，去掉单位后用 Long.parseLong 读取数字。",
      "sortOrder": 106,
      "starterCode": [
        "import java.util.Scanner;",
        "",
        "public class Main {",
        "    static long toBytes(String reading) {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) {",
        "        try (Scanner input = new Scanner(System.in)) {",
        "            long before = toBytes(input.next());",
        "            long after = toBytes(input.next());",
        "            System.out.println(after - before);",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        int unitIndex = reading.length() - 1;",
        "        long amount = Long.parseLong(reading.substring(0, unitIndex));",
        "        long multiplier = switch (reading.charAt(unitIndex)) {",
        "            case 'K' -> 1024L;",
        "            case 'M' -> 1024L * 1024;",
        "            case 'G' -> 1024L * 1024 * 1024;",
        "            default -> throw new IllegalArgumentException(\"未知单位\");",
        "        };",
        "        return amount * multiplier;"
      ],
      "cases": [
        {
          "name": "混合单位",
          "stdin": "512K 2M\n",
          "expected": "1572864"
        },
        {
          "name": "用量下降",
          "stdin": "3G 2G\n",
          "expected": "-1073741824"
        },
        {
          "name": "不同单位但相等",
          "stdin": "1M 1024K\n",
          "expected": "0"
        },
        {
          "name": "超过 int 范围",
          "stdin": "0K 4G\n",
          "expected": "4294967296"
        }
      ]
    }
  },
