  {
    "noteId": "future-results",
    "lessonSlug": "thread-pool",
    "question": {
      "type": "CHOICE",
      "difficulty": "MEDIUM",
      "prompt": "调用 Future.get(2, TimeUnit.SECONDS) 等到超时后，后台任务会怎样？",
      "explanation": "带超时的 get 限制调用方的等待时间。抛出 TimeoutException 后任务仍可能执行，若需取消，应显式调用 cancel，并让任务配合中断。",
      "options": [
        "A. 任务保证立刻停止",
        "B. 任务仍可能继续运行",
        "C. 线程池会自动关闭",
        "D. Future 保证返回默认值"
      ],
      "answerKey": "B"
    },
    "exercise": {
      "title": "用 Future 按提交顺序收集平方结果",
      "description": "读入任务数 n 和 n 个整数，每个整数的绝对值不超过 46340。使用 ExecutorService 为每个数字提交平方计算，按输入顺序收集 Future 的结果并返回。主程序将结果以空格分隔输出，任务为空时输出 EMPTY。\n\n示例输入\n4\n-3 2 0 -5\n\n示例输出\n9 4 0 25",
      "difficulty": "INTERMEDIATE",
      "hint": "先按输入顺序保存 submit 返回的 Future，再遍历 Future 获取结果。用 finally 关闭线程池。",
      "sortOrder": 105,
      "starterCode": [
        "import java.util.ArrayList;",
        "import java.util.List;",
        "import java.util.Scanner;",
        "import java.util.concurrent.ExecutionException;",
        "import java.util.concurrent.Executors;",
        "import java.util.concurrent.Future;",
        "",
        "public class Main {",
        "    static List<Integer> squareInOrder(List<Integer> numbers)",
        "            throws InterruptedException, ExecutionException {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) throws Exception {",
        "        try (Scanner input = new Scanner(System.in)) {",
        "            int size = input.nextInt();",
        "            var numbers = new ArrayList<Integer>();",
        "            for (int i = 0; i < size; i++) {",
        "                numbers.add(input.nextInt());",
        "            }",
        "            List<Integer> results = squareInOrder(numbers);",
        "            System.out.println(results.isEmpty() ? \"EMPTY\"",
        "                    : String.join(\" \", results.stream().map(String::valueOf).toList()));",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        var pool = Executors.newFixedThreadPool(2);",
        "        try {",
        "            var tasks = new ArrayList<Future<Integer>>();",
        "            for (int number : numbers) {",
        "                tasks.add(pool.submit(() -> number * number));",
        "            }",
        "            var results = new ArrayList<Integer>();",
        "            for (Future<Integer> task : tasks) {",
        "                results.add(task.get());",
        "            }",
        "            return results;",
        "        } finally {",
        "            pool.shutdown();",
        "        }"
      ],
      "cases": [
        {
          "name": "保持输入顺序",
          "stdin": "4\n-3 2 0 -5\n",
          "expected": "9 4 0 25"
        },
        {
          "name": "无任务",
          "stdin": "0\n",
          "expected": "EMPTY"
        },
        {
          "name": "最大安全平方",
          "stdin": "3\n46340 -1 -46340\n",
          "expected": "2147395600 1 2147395600"
        },
        {
          "name": "重复任务",
          "stdin": "4\n3 3 1 3\n",
          "expected": "9 9 1 9"
        }
      ]
    }
  },
