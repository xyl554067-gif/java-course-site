        "import java.util.Scanner;",
        "",
        "public class Main {",
        "    static String summarize(Scanner in, int n, String prefix) {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) {",
        "        Scanner in = new Scanner(System.in);",
