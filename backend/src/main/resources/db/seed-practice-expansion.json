    "id": "range-sum",
    "lessonSlug": "arrays",
    "resourceNoteId": "array-boundaries",
    "questions": [
      {
        "prompt": "把 prefix[i] 定义为数组前 i 项的和。闭区间 [left, right] 的下标从 0 开始，应该怎样求和？",
        "type": "CHOICE",
        "difficulty": "MEDIUM",
        "options": [
          "A. prefix[right] - prefix[left]",
          "B. prefix[right + 1] - prefix[left + 1]",
          "C. prefix[right + 1] - prefix[left]",
          "D. prefix[right] - prefix[left + 1]"
        ],
        "answerKey": "C",
        "explanation": "right 对应元素需要计入，因此前缀取到 right + 1，再扣除 left 前面的项。"
      },
      {
        "prompt": "长度为 n 的数组可访问 a[n]，它会返回该类型的默认值。",
        "type": "JUDGE",
        "difficulty": "EASY",
        "options": null,
        "answerKey": "FALSE",
        "explanation": "合法下标为 0 到 n - 1，a[n] 会抛出 ArrayIndexOutOfBoundsException。"
      },
      {
        "prompt": "多个 int 元素相加为什么可能要用 long，即使每个元素都在 int 范围内？",
        "type": "SHORT_ANSWER",
        "difficulty": "MEDIUM",
        "options": null,
        "answerKey": null,
        "explanation": "总和可能超出 int 的范围。应从第一个加法开始使用 long 累加，避免先在 int 中溢出再转换。"
      }
    ],
    "exercise": {
      "title": "多次查询区间和",
      "description": "输入 n、q，然后是 n 个整数，再输入 q 组下标 left、right（0 ≤ left ≤ right < n）。每组输出该闭区间的元素和。完成 prefixSums，要求预处理 O(n)，每组查询 O(1)。总和可能超出 int。",
      "difficulty": "MEDIUM",
      "hint": "让 prefix[0] 为 0，prefix[i + 1] 累加到下标 i，用 long 保存。",
      "sortOrder": 30,
      "starterCode": [
        "import java.util.Scanner;",
        "",
        "public class Main {",
        "    static long[] prefixSums(int[] values) {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) {",
        "        Scanner in = new Scanner(System.in);",
        "        int n = in.nextInt();",
        "        int q = in.nextInt();",
        "        int[] values = new int[n];",
        "        for (int i = 0; i < n; i++) {",
        "            values[i] = in.nextInt();",
        "        }",
        "        long[] prefix = prefixSums(values);",
        "        for (int i = 0; i < q; i++) {",
        "            int left = in.nextInt();",
        "            int right = in.nextInt();",
        "            System.out.println(prefix[right + 1] - prefix[left]);",
        "        }",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        long[] prefix = new long[values.length + 1];",
        "        for (int i = 0; i < values.length; i++) {",
        "            prefix[i + 1] = prefix[i] + values[i];",
        "        }",
        "        return prefix;"
      ],
      "cases": [
        {
          "name": "单项与完整区间",
          "stdin": "5 3\n2 -3 7 4 -1\n0 0\n1 3\n0 4",
          "expected": "2\n8\n9"
        },
        {
          "name": "超过 int 上限",
          "stdin": "2 1\n2147483647 2147483647\n0 1",
          "expected": "4294967294"
        },
        {
          "name": "全为负数",
          "stdin": "3 2\n-8 -2 -1\n0 2\n2 2",
          "expected": "-11\n-1"
        },
        {
          "name": "没有查询",
          "stdin": "1 0\n42",
          "expected": ""
        }
      ]
    }
  },
