  {
    "id": "recover-task-errors",
    "lessonSlug": "thread-pool",
    "resourceNoteId": "future-results",
    "questions": [
      {
        "prompt": "任务本身抛出异常后，调用对应 Future.get() 通常收到什么？",
        "type": "CHOICE",
        "difficulty": "MEDIUM",
        "options": [
          "A. 返回 null",
          "B. 返回任务的默认类型值",
          "C. 抛出 ExecutionException",
          "D. 重新执行任务"
        ],
        "answerKey": "C",
        "explanation": "get 会通过 ExecutionException 报告任务异常，原异常可通过 getCause() 读取。"
      },
      {
        "prompt": "在按提交顺序保存的 Future 列表上顺序调用 get，可以按提交顺序输出结果，即使任务实际完成顺序不同。",
        "type": "JUDGE",
        "difficulty": "MEDIUM",
        "options": null,
        "answerKey": "TRUE",
        "explanation": "列表决定输出顺序。遇到还未完成的 Future，get 会等到对应任务结束。"
      },
      {
        "prompt": "创建自己的线程池后，为什么适合在 finally 中调用 shutdown？",
        "type": "SHORT_ANSWER",
        "difficulty": "HARD",
        "options": null,
        "answerKey": null,
        "explanation": "正常完成或中途抛异常时都能停止接收新任务。已有任务依然可以执行完，线程池随后得以结束。"
      }
    ],
    "exercise": {
      "title": "汇总线程池任务与失败结果",
      "description": "输入 n 和 n 个整数。每个整数对应一个 Callable，非负时返回平方（用 long），负数时抛出 IllegalArgumentException。按提交顺序输出每项结果，失败输出 ERR，并继续处理后续任务。最后关闭线程池。",
      "difficulty": "HARD",
      "hint": "先提交所有任务，再逐个 get；每个 get 单独处理 ExecutionException。线程池放到 finally 中关闭。",
      "sortOrder": 36,
      "starterCode": [
        "import java.util.ArrayList;",
        "import java.util.List;",
        "import java.util.Scanner;",
        "import java.util.concurrent.ExecutionException;",
        "import java.util.concurrent.ExecutorService;",
        "import java.util.concurrent.Executors;",
        "import java.util.concurrent.Future;",
        "",
        "public class Main {",
        "    static List<String> collect(int[] jobs) throws InterruptedException {",
        "        throw new UnsupportedOperationException(\"请完成方法\");",
        "    }",
        "",
        "    public static void main(String[] args) throws InterruptedException {",
        "        Scanner in = new Scanner(System.in);",
        "        int[] jobs = new int[in.nextInt()];",
        "        for (int i = 0; i < jobs.length; i++) {",
        "            jobs[i] = in.nextInt();",
        "        }",
        "        collect(jobs).forEach(System.out::println);",
        "    }",
        "}"
      ],
      "solutionBody": [
        "        ExecutorService pool = Executors.newFixedThreadPool(2);",
        "        try {",
        "            List<Future<Long>> futures = new ArrayList<>();",
        "            for (int value : jobs) {",
        "                futures.add(pool.submit(() -> {",
        "                    if (value < 0) throw new IllegalArgumentException(\"negative\");",
        "                    return (long) value * value;",
        "                }));",
        "            }",
        "            List<String> results = new ArrayList<>();",
        "            for (Future<Long> future : futures) {",
        "                try {",
        "                    results.add(String.valueOf(future.get()));",
        "                } catch (ExecutionException e) {",
        "                    results.add(\"ERR\");",
        "                }",
        "            }",
        "            return results;",
        "        } finally {",
        "            pool.shutdown();",
        "        }"
      ],
      "cases": [
        {
          "name": "失败不影响后续任务",
          "stdin": "4\n3 -1 0 4",
          "expected": "9\nERR\n0\n16"
        },
        {
          "name": "平方结果超过 int",
          "stdin": "1\n50000",
          "expected": "2500000000"
        },
        {
          "name": "全部失败",
          "stdin": "2\n-2 -3",
          "expected": "ERR\nERR"
        },
        {
          "name": "没有任务",
          "stdin": "0",
          "expected": ""
        }
      ]
    }
  },
